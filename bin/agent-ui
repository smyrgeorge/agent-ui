#!/usr/bin/env bash
# Show things in Emacs beside an agent's session: progress bars, tables,
# checklists, on its canvas (agent-ui.el). For coding agents, from their
# shell. See https://github.com/smyrgeorge/agent-ui.
#
#   agent-ui show [JSON]         show a component: {"id":..., "type":...}
#                                (its id there already: replaced in place)
#   agent-ui update ID [JSON]    change some of its properties ({"value": 5});
#                                null puts one back to its default
#   agent-ui append ID [JSON]    add to its lists ({"rows": [[...]]})
#   agent-ui remove ID           remove it
#   agent-ui clear               remove every component
#   agent-ui list                the canvas's components: ids, types, sources
#   agent-ui get [ID] [--changed]
#                                what it shows, as data: its components (or ID's)
#                                with their properties and values, as JSON;
#                                --changed: only those changed since your last
#                                read (and "removed": those gone). A
#                                dashboard (--dashboard NAME): when it last
#                                fetched; hidden
#                                and old, fetched first (its reply waited for,
#                                AGENT_UI_WAIT seconds at most, default 10)
#   agent-ui types [TYPE]        the component types: properties, an example
#   agent-ui batch [JSON]        several at once: [{"op": "show", ...},
#                                {"op": "update", "id": ..., ...}, ...]
#   agent-ui render [--ansi] [JSON]
#                                a component drawn as text, as the canvas
#                                would (nothing shown): what it looks like;
#                                --ansi: in its colours, for a terminal
#   agent-ui snapshot ID         the component as an image (SVG) in
#                                .agent-shell/images/: {"file", "markdown"},
#                                a link for your reply (shown inline)
#   agent-ui define [FILE]       a type of your own: its Emacs Lisp code
#                                (one agent-ui-define), from FILE or stdin;
#                                staged for the user to keep or discard
#   agent-ui dashboards          the project's dashboards (.agent-ui/
#                                dashboards/): {"dashboards": [{"name",
#                                "open"}]}
#   agent-ui open NAME           one of them opened in the user's Emacs
#                                (its code asked for, if it must be)
#   agent-ui check NAME          a project dashboard's file (.agent-ui/
#                                dashboards/NAME.el, or a FILE.el) checked,
#                                nothing run: its UI, its code compiled, its
#                                calls that wait: {"warnings", "blocking"}
#   agent-ui bug [JSON]          a bug in Agent UI itself, filed in its own
#                                issues (not this project's): {"title",
#                                "description", "expected", "workaround",
#                                "component": ID, "repro": {component}} ->
#                                {"ok": true, "issue": ID}; not filed:
#                                {"ok": false, "error", "report"}
#   agent-ui doctor              is everything Agent UI needs here? this
#                                command's checks (an emacsclient, a server
#                                answering, its session), then Emacs's:
#                                {"ok", "summary", "checks": [{"group",
#                                "name", "status": ok|warn|fail, "detail",
#                                "fix"}]}; ok false (exit 1) when one fails;
#                                no Emacs to ask: this side's alone (exit 3)
#
# --dashboard NAME (any operation): the project's open dashboard NAME's canvas.
# --canvas NAME (any operation): the session's other canvas NAME ("tests"),
# shown beside its canvas, instead of it; "canvas": NAME in the JSON
# (a component's, a change's, a batch's operation's) says the same.
#
# JSON is the last argument, or comes on stdin. The reply is JSON on stdout:
# {"ok": true, "id": ...}, or {"ok": false, "error": "what's wrong"}.
#
# Exit status: 0 done, 1 not done (the reply says why), 2 a wrong use,
# 3 no Emacs to talk to (it runs as a server: M-x server-start).
#
# AGENT_UI_SESSION (set by agent-shell for its agents) names the session whose
# canvas it is; without it, the session working in this directory's. EMACSCLIENT
# (default: emacsclient) is the client, EMACS_SOCKET_NAME its server.

set -u

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0"; }

json_string() {  # json_string TEXT: TEXT as a JSON string
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

fail() {  # fail STATUS MESSAGE: the reply for an error, and exit
  printf '{"ok":false,"error":%s}\n' "$(json_string "$2")"
  exit "$1"
}

[ $# -eq 0 ] && { usage >&2; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac

# --canvas NAME, wherever it is: taken out.
canvas="" dashboard="" args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dashboard) [ $# -lt 2 ] && fail 2 "--dashboard: which dashboard? --dashboard NAME"
                 dashboard=$2; shift 2 ;;
    --dashboard=*) dashboard=${1#--dashboard=}; shift ;;
    --canvas) [ $# -lt 2 ] && fail 2 "--canvas: which canvas? --canvas NAME"
              canvas=$2; shift 2 ;;
    --canvas=*) canvas=${1#--canvas=}; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
case "$canvas$dashboard" in *$'\n'*) fail 2 "a canvas's or a dashboard's name is one line" ;; esac
set -- ${args[@]+"${args[@]}"}
[ $# -eq 0 ] && { usage >&2; exit 2; }

op=$1; shift
id="" json="" takes_json=0 options=""
if [ "$op" = render ] && [ "${1:-}" = --ansi ]; then options=ansi; shift; fi
if [ "$op" = get ]; then
  rest=()
  for arg in "$@"; do
    case "$arg" in --changed) options=changed ;; *) rest+=("$arg") ;; esac
  done
  set -- ${rest[@]+"${rest[@]}"}
fi
case "$op" in
  show|batch|render|bug)
    takes_json=1
    [ $# -gt 1 ] && fail 2 "$op: too many arguments (JSON only)"
    [ $# -eq 1 ] && json=$1 ;;
  update|append)
    takes_json=1
    [ $# -lt 1 ] && fail 2 "$op: which component? agent-ui $op ID [JSON]"
    [ $# -gt 2 ] && fail 2 "$op: too many arguments (ID, then JSON)"
    id=$1
    [ $# -eq 2 ] && json=$2 ;;
  remove|snapshot)
    [ $# -ne 1 ] && fail 2 "$op: agent-ui $op ID"
    id=$1 ;;
  check|open)
    [ $# -ne 1 ] && fail 2 "$op: agent-ui $op NAME (a dashboard of this project)"
    id=$1 ;;
  dashboards)
    [ $# -gt 0 ] && fail 2 "dashboards: takes no arguments" ;;
  types)
    [ $# -gt 1 ] && fail 2 "types: agent-ui types [TYPE]"
    id=${1:-} ;;
  get)
    [ $# -gt 1 ] && fail 2 "get: agent-ui get [ID] [--changed]"
    id=${1:-} ;;
  define)
    takes_json=1
    [ $# -gt 1 ] && fail 2 "define: agent-ui define [FILE]"
    if [ $# -eq 1 ]; then
      [ -f "$1" ] || fail 2 "define: no file $1"
      json=$(cat "$1")
      [ -n "$json" ] || fail 2 "define: $1 is empty"
    fi ;;
  clear|list|doctor)
    [ $# -gt 0 ] && fail 2 "$op: takes no arguments" ;;
  *)
    fail 2 "unknown operation \"$op\"; operations: show, update, append, remove, clear, list, get, types, batch, render, define, snapshot, bug, check, dashboards, open, doctor" ;;
esac
case "$id" in *$'\n'*) fail 2 "an id is one line" ;; esac

if [ "$takes_json" = 1 ] && [ -z "$json" ]; then
  [ -t 0 ] && fail 2 "$op: give it as the last argument, or on stdin"
  json=$(cat)
fi

# doctor: this side's checks first, each a line for Emacs (STATUS, NAME,
# DETAIL, FIX, separated by tabs) and JSON for a reply without it.
checks="" checks_json=""
check() {  # check STATUS NAME DETAIL [FIX]: one of this side's checks
  local detail=${3//[$'\t\n']/ } fix=${4:-}
  fix=${fix//[$'\t\n']/ }
  checks+="$1"$'\t'"$2"$'\t'"$detail"$'\t'"$fix"$'\n'
  checks_json+="${checks_json:+,}{\"group\":\"Command\",\"name\":$(json_string "$2"),\"status\":\"$1\",\"detail\":$(json_string "$detail")${fix:+,\"fix\":$(json_string "$fix")}}"
}
doctor_alone() {  # doctor_alone ERROR: this side's checks, no Emacs to ask; exit 3
  local n kind summary=""
  for kind in fail warn ok; do
    n=$(printf '%s' "$checks" | grep -c "^$kind")
    [ "$n" -eq 0 ] && [ "$kind" != ok ] && continue
    case $kind in
      fail) summary+="$n failed, " ;;
      warn) summary+="$n warning$([ "$n" -eq 1 ] || echo s), " ;;
      ok) summary+="$n passed" ;;
    esac
  done
  printf '{"ok":false,"error":%s,"summary":%s,"checks":[%s]}\n' \
         "$(json_string "$1")" "$(json_string "$summary")" "$checks_json"
  exit 3
}
if [ "$op" = doctor ]; then
  client=${EMACSCLIENT:-emacsclient}
  if client_file=$(command -v "$client"); then
    check ok emacsclient "$client_file"
  else
    check fail emacsclient "$client isn't on PATH" \
          "Put emacsclient (it comes with Emacs) on PATH, or set EMACSCLIENT to it"
  fi
  if [ -n "${AGENT_UI_SESSION:-}" ]; then
    check ok Session "agent-shell session $AGENT_UI_SESSION"
  else
    check warn Session "not run by an agent-shell session: the canvas is the session's working here, else the default" \
          "Run it from an agent's shell (agent-ui-mode gives each session's agent AGENT_UI_SESSION)"
  fi
  [ -n "$client_file" ] || doctor_alone "no emacsclient to reach Emacs with"
fi

dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-ui.XXXXXXXXXX") || fail 3 "no temp folder"
trap 'rm -rf "$dir"' EXIT
printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$op" "$id" "${AGENT_UI_SESSION:-}" "$PWD" "$options" "$canvas" "$dashboard" >"$dir/request"
[ "$takes_json" = 1 ] && printf '%s' "$json" >"$dir/payload"
# doctor's payload: this command's file, then its checks.
[ "$op" = doctor ] && printf '%s\n%s' "$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")" "$checks" >"$dir/payload"

# The folder as a Lisp string.
lisp_dir=${dir//\\/\\\\}
lisp_dir=${lisp_dir//\"/\\\"}
# Who answers in Emacs: doctor's own (agent-ui-doctor.el, loading nothing
# else), there even when the rest of Agent UI failed to load.
answer=agent-ui-request
[ "$op" = doctor ] && answer=agent-ui-doctor-request
ask() {  # ask: Emacs answers the request (its reply in $dir/reply)
  rm -f "$dir/reply"
  out=$("${EMACSCLIENT:-emacsclient}" --timeout=30 --eval \
          "(if (fboundp '$answer) ($answer \"$lisp_dir\") 'agent-ui-not-loaded)" 2>&1)
  status=$?
}
ask
# get on a dashboard being fetched (it was hidden, its data old): asked again
# once its queries end, AGENT_UI_WAIT seconds at most.
if [ "$op" = get ]; then
  waited=0
  while [ -f "$dir/reply" ] && grep -q '"fetching":true' "$dir/reply" \
          && [ "$waited" -lt "$(( ${AGENT_UI_WAIT:-10} * 4 ))" ]; do
    sleep 0.25
    waited=$((waited + 1))
    ask
  done
fi

if [ -f "$dir/reply" ]; then
  cat "$dir/reply"
  grep -q '^{"ok":true' "$dir/reply" && exit 0
  exit 1
fi
if [ "$op" = doctor ]; then
  case "$out" in
    *agent-ui-not-loaded*)
      check fail "Agent UI in Emacs" "Emacs answered, but Agent UI isn't loaded there" \
            "(require 'agent-ui) and (agent-ui-mode 1) in your init, then M-x agent-ui-doctor there"
      doctor_alone "Emacs runs, but without Agent UI" ;;
  esac
  if [ $status -ne 0 ]; then
    check fail "Emacs server" "no Emacs server answered: $out" \
          "M-x server-start in Emacs, or (server-start) in your init; EMACS_SOCKET_NAME if it listens elsewhere"
    doctor_alone "no Emacs server answered"
  fi
  check fail "Emacs server" "Emacs didn't answer: $out" "Check Emacs isn't busy, then M-x agent-ui-doctor there"
  doctor_alone "Emacs didn't answer"
fi
case "$out" in
  *agent-ui-not-loaded*) fail 3 "Emacs runs, but without Agent UI (M-x agent-ui-mode)" ;;
esac
[ $status -ne 0 ] && fail 3 "no Emacs server answered (M-x server-start): ${out//$'\n'/ }"
fail 3 "Emacs didn't answer: ${out//$'\n'/ }"
